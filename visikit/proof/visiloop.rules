# VisiLoop detection-proof rules.
# A harmless test signature modelled on the classic "id check returned root" IDS test:
# it fires when a server response contains the output of the `id` command for root,
# the pattern IDS teams use to confirm a sensor sees response traffic. It matches only
# synthetic test traffic generated by VisiLoop's benchmark.
alert tcp any any -> any any (msg:"VisiLoop test: root id check returned in server response"; flow:established,to_client; content:"uid=0(root) gid=0(root)"; classtype:bad-unknown; sid:9000001; rev:1;)
